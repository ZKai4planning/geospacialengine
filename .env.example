PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=

# MOCK_PROVIDERS=true -> built-in sample data (postcode E6 2AA), no network needed
MOCK_PROVIDERS=false

# ---- Provider choice: leave on "auto" and just add the keys you have ----
ADDRESS_PROVIDER=auto        # auto | os | osm      (auto = OS Places if OS_DATA_HUB_KEY is set, else OpenStreetMap)
AERIAL_PROVIDER=auto         # auto | esri | google | none   (auto = Google if key set, else Esri – no key needed)
STREETVIEW_PROVIDER=auto     # auto | mapillary | google | none  (auto = Google if key, else Mapillary if token, else placeholder)

# ---- Everything below is OPTIONAL ----
# Free token: https://www.mapillary.com/developer  (street-level photos)
MAPILLARY_TOKEN=
# Ordnance Survey Data Hub (authoritative UK addresses + UPRN)
OS_DATA_HUB_KEY=
# Google Maps Platform (Street View Static + Maps Static)
GOOGLE_MAPS_API_KEY=
GOOGLE_URL_SIGNING_SECRET=

CACHE_TTL_SECONDS=3600

# ---- Free OpenStreetMap services REQUIRE you to identify your app (otherwise Overpass answers 406/429) ----
# Put a real contact URL or email in here.
HTTP_USER_AGENT=uk-planning-engine/1.0 (+https://your-site.example/contact)
# Overpass mirrors tried in order (comma separated). Self-host Overpass/Photon for production.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_MS=15000   # per-mirror timeout; raise if your network is slow
OVERPASS_RADIUS_M=120        # search radius around the postcode centre; lower = faster

POSTCODES_TIMEOUT_MS=15000   # postcodes.io per-attempt timeout (2 retries); raise on slow networks
IMAGERY_TIMEOUT_MS=30000    # per-attempt timeout for aerial / street photos (slow networks)
# Fallback map (used when aerial / street photos are unavailable). OSM's own tile server is for light/dev use only –
# for production use a paid provider (MapTiler, Stadia, Thunderforest) or your own tile server. {z}/{x}/{y} are required.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILE_MAX_ZOOM=19
OPEN_UPRN_MAX_M=15           # max distance between an address point and the UPRN point we accept

# ---- Postgres (stores application drafts + the OS Open UPRN table; needed on Vercel) ----
# Any standard Postgres. DigitalOcean: Databases -> your cluster -> Connection details.
# On Vercel use the *connection pool* string (PgBouncer, port 25061, mode "Transaction"). Looks like:
#   postgresql://doadmin:PASSWORD@your-pool-host.db.ondigitalocean.com:25061/your-pool?sslmode=require
DATABASE_URL=
# Optional: the provider's CA certificate (PEM; use \n for line breaks) for full TLS verification. Without it the connection is encrypted but not verified.
DATABASE_CA_CERT=
DATABASE_SSL=require
# Connections each warm serverless instance may open. Keep small on Vercel.
PG_POOL_MAX=3
# Only for `npm run import:uprn` on your own machine: the DIRECT connection string (port 25060, not the pooler). Do NOT add to Vercel.
DATABASE_DIRECT_URL=
