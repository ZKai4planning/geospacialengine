PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=

# MOCK_PROVIDERS=true -> built-in sample data (postcode E6 2AA), no network needed
MOCK_PROVIDERS=false

# ---- Provider choice: leave on "auto" and just add the keys you have ----
ADDRESS_PROVIDER=auto        # auto | os | osm      (auto = OS Places if OS_DATA_HUB_KEY is set, else OpenStreetMap)
AERIAL_PROVIDER=auto         # auto | esri | google | none   (auto = Google if key set, else Esri – no key needed)
STREETVIEW_PROVIDER=auto     # auto | mapillary | google | none  (auto = Google if key, else Mapillary if token, else placeholder)

# ---- Everything below is OPTIONAL ----
# Free token: https://www.mapillary.com/developer  (street-level photos)
MAPILLARY_TOKEN=
# Ordnance Survey Data Hub (authoritative UK addresses + UPRN)
OS_DATA_HUB_KEY=
# Google Maps Platform (Street View Static + Maps Static)
GOOGLE_MAPS_API_KEY=
GOOGLE_URL_SIGNING_SECRET=

CACHE_TTL_SECONDS=3600

# ---- Free OpenStreetMap services REQUIRE you to identify your app (otherwise Overpass answers 406/429) ----
# Put a real contact URL or email in here.
HTTP_USER_AGENT=uk-planning-engine/1.0 (+https://your-site.example/contact)
# Overpass mirrors tried in order (comma separated). Self-host Overpass/Photon for production.
# Public Overpass mirrors (fallback). Only list ones that answer from your network (npm run diagnose tells you).
OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter
# Your own Overpass server (deploy/overpass). Tried first; the key is sent as the X-Api-Key header. Leave both blank until it answers.
# OVERPASS_SELF_URL=https://overpass.ai4planning.com/api/interpreter
# OVERPASS_SELF_KEY=
OVERPASS_TIMEOUT_MS=15000   # per-mirror timeout; raise if your network is slow
OVERPASS_RADIUS_M=120        # search radius around the postcode centre; lower = faster

POSTCODES_TIMEOUT_MS=15000   # postcodes.io per-attempt timeout (2 retries); raise on slow networks
IMAGERY_TIMEOUT_MS=30000    # per-attempt timeout for aerial / street photos (slow networks)
# Fallback map (used when aerial / street photos are unavailable). OSM's own tile server is for light/dev use only –
# for production use a paid provider (MapTiler, Stadia, Thunderforest) or your own tile server. {z}/{x}/{y} are required.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILE_MAX_ZOOM=19
OPEN_UPRN_MAX_M=15           # max distance between an address point and the UPRN point we accept

# ---- Postgres (stores application drafts + the OS Open UPRN table; needed on Vercel) ----
# Any standard Postgres. DigitalOcean: Databases -> your cluster -> Connection details.
# On Vercel use the *connection pool* string (PgBouncer, port 25061, mode "Transaction"). Looks like:
#   postgresql://doadmin:PASSWORD@your-pool-host.db.ondigitalocean.com:25061/your-pool?sslmode=require
DATABASE_URL=
# Optional: the provider's CA certificate (PEM; use \n for line breaks) for full TLS verification. Without it the connection is encrypted but not verified.
DATABASE_CA_CERT=
DATABASE_SSL=require
# Connections each warm serverless instance may open. Keep small on Vercel.
PG_POOL_MAX=3
# Only for `npm run import:uprn` on your own machine: the DIRECT connection string (port 25060, not the pooler). Do NOT add to Vercel.
DATABASE_DIRECT_URL=

# Optional: Energy Performance Certificate register (free account) - gives the real number of habitable rooms, built form and age band.
EPC_API_URL=https://epc.opendatacommunities.org/api/v1/domestic/search
EPC_API_EMAIL=
EPC_API_KEY=

# Land Registry Price Paid Data (open, no key): sale history, property type, tenure, new-build flag and street comparables.
PPD_SPARQL_URL=https://landregistry.data.gov.uk/landregistry/query

# Planning history (earlier applications at the address and similar work nearby) from PlanIt. OFF by default:
# PlanIt is free for non-commercial use and has a commercial licence - check its terms before switching this on.
PLANNING_HISTORY_ENABLED=false
PLANIT_URL=https://www.planit.org.uk/api/applics/json

# ---- Roof / eaves height from Environment Agency LiDAR (England). Needs: npm i geotiff ----
LIDAR_ENABLED=true
# Defaults are the EA's WCS 2.0.1 services (Defra Data Services Platform, OGL): DTM dataset 13787b9a-..., DSM (last return) dataset 9ba4d5ac-....
# Leave all of these blank to use the defaults. `npm run check:lidar` shows whether they answer and prints the real axis labels.
LIDAR_DTM_URL=
LIDAR_DTM_COVERAGE=
LIDAR_DSM_URL=
LIDAR_DSM_COVERAGE=
# WCS axis labels for EPSG:27700 (default E,N). Only change if check:lidar says the server wants e.g. x,y.
LIDAR_AXES=

# ---- Coal mining Development High Risk Areas (Mining Remediation Authority). OFF by default ----
# The data's re-use licence is unclear (listed as OGL on data.gov.uk, but the dataset metadata says "Coal Authority data licence").
# Ask datasolutions@miningremediation.gov.uk before storing or serving it in a product. Then either load it (db/schema-coal.sql, npm run import:coal)
# or point COAL_LIVE_URL at an ArcGIS FeatureServer layer you are allowed to query (e.g. https://.../FeatureServer/0).
COAL_RISK_ENABLED=false
# Free live data from the Mining Remediation Authority's own map services (Open Government Licence terms apply; credit them):
# COAL_LIVE_URL=https://map.bgs.ac.uk/arcgis/rest/services/CoalAuthority   (high-risk area + shallow workings, mine entries, fissures, outcrops, surface mining)
# or a single layer, e.g. .../CoalAuthority/coalauthority_planning_policy_constraints/MapServer/0   (high-risk area only)
COAL_LIVE_URL=

# Historic landfill sites (made ground), Environment Agency, England only. Conditional Licence (not OGL): read it, keep the attribution, then switch on.
# https://www.gov.uk/government/publications/environment-agency-conditional-licence
LANDFILL_ENABLED=false
# LANDFILL_URL=https://environment.data.gov.uk/arcgis/rest/services/EA/HistoricLandfill/FeatureServer/0

# ---- Open environmental data (no key, Open Government Licence). Both ON by default; set false to switch off. Run `npm run verify:open-data` once where the network is open.
# Environment Agency: surface water risk, recorded flood outlines, reservoir flood extents (PI-08-02, 08-03, 08-05, 08-12).
FLOOD_DATA_ENABLED=true
# OpenStreetMap: watercourses, substations, traffic signals in one Overpass request (PI-08-07, 08-08, 10-03, 11-03).
OSM_INFRA_ENABLED=true

# More open data read live (no key): air quality areas (planning.data.gov.uk), EA flood defences and main river (OGC API), Defra road noise (WCS raster). ON by default.
OPEN_LAYERS_ENABLED=true
# You normally add NOTHING here: each line below has a working default in src/providers/openLayers.js. Uncomment a line ONLY when `npm run verify:open-data` shows
# the default failing, and paste the value it tells you. What each one is, with the value it defaults to:
#
# FLOOD_DEFENCES_URL=   EA OGC API - Features base URL (ends in /ogc/features/v1). Default:
#                       https://environment.data.gov.uk/spatialdata/spatial-flood-defences-including-standardised-attributes/ogc/features/v1
# MAIN_RIVER_URL=       Same kind of URL for the Statutory Main River Map. Default:
#                       https://environment.data.gov.uk/spatialdata/statutory-main-river-map/ogc/features/v1
# NOISE_ROAD_WCS_URL=   Defra road-noise WCS endpoint (ends in /wcs). Default:
#                       https://environment.data.gov.uk/spatialdata/road-noise-all-metrics-england-round-4/wcs
# NOISE_RAIL_WCS_URL=   Rail noise. Off by default. Reported working for round 4 Lden: https://environment.data.gov.uk/spatialdata/noise-data/wcs
#                       (switch it on only after verify:open-data section 8 shows rail answering for you)
# NOISE_WCS_AXES=E,N    The two axis labels for the WCS 2.0.1 fallback (easting, northing). Leave as E,N unless the server's DescribeCoverage says x,y.
# SURFACE_WATER_WMS_LAYER=   Exact WMS layer name for surface water risk. Blank = the app reads it from the service's GetCapabilities. Set it only if
#                       verify:open-data prints a layer list and the automatic pick is wrong.

# ---- 228-parameter register -------------------------------------------------------------------------------------------------------------------
# Datasets and council standards you load onto your own Postgres / VPS (npm run db:schema:geo, then npm run import:geo - see reports/dataset-loading-guide.md).
GEO_LAYERS_ENABLED=true
# Substations and traffic signals from Overpass (one request per application).
OSM_EXTRAS_ENABLED=true
# Enables reviewer sign-off (PI-17-11), officer outcomes (PI-17-12) and GET /api/review-queue. Send "Authorization: Bearer <token>". Unset = those endpoints are closed.
# Use a long random value, e.g. openssl rand -hex 32
REVIEWER_TOKEN=
# true = the printable pack (GET /api/applications/:id/ldc-pack) is refused with the list of blockers until the planning readiness gate (PI-17-14) is released.
READINESS_ENFORCE=false
