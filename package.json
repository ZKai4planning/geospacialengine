  "description": "Address lookup, property enrichment, street view and permitted-development engine for UK planning applications",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
